# =============================================================================
# [NOME_DA_LOJA] — modelo de variáveis de ambiente
# =============================================================================
#
# Este arquivo lista APENAS OS NOMES das variáveis. Nunca contém valores.
#
#   1. Copie para `.env` na raiz do projeto.
#   2. Preencha os valores localmente.
#   3. `.env` está no .gitignore e NUNCA deve ser commitado.
#   4. Em produção, os valores vivem no gerenciador de segredos do provedor,
#      nunca em arquivo no servidor.
#
# A aplicação valida as variáveis obrigatórias na inicialização e falha ao subir
# se alguma estiver ausente. Ver DEPLOYMENT.md §2.
# =============================================================================


# --- Aplicação ---------------------------------------------------------------
NODE_ENV=
APP_URL=
APP_NAME=


# --- Banco de dados ----------------------------------------------------------
# String de conexão PostgreSQL. Contém credencial — tratar como segredo.
DATABASE_URL=

# Conexão direta, sem pool, usada por migrations em provedores com pooler.
DIRECT_URL=


# --- Sessão e criptografia ---------------------------------------------------
# Segredo de assinatura de sessão. Gerar aleatório com entropia alta.
# Rotacionar invalida todas as sessões ativas.
SESSION_SECRET=

# Nome do cookie de sessão.
SESSION_COOKIE_NAME=


# --- Pagamento: Mercado Pago -------------------------------------------------
# Credenciais de SANDBOX e de PRODUÇÃO nunca coexistem no mesmo ambiente.
# Ver ARCHITECTURE.md §5.1 e ADR-0004.

# Token de acesso do servidor. SEGREDO — nunca expor ao cliente.
MERCADOPAGO_ACCESS_TOKEN=

# Chave pública, usada apenas no cliente quando houver checkout embutido.
MERCADOPAGO_PUBLIC_KEY=

# Segredo de validação de assinatura das notificações recebidas.
MERCADOPAGO_WEBHOOK_SECRET=

# URL pública que recebe as notificações do gateway.
MERCADOPAGO_WEBHOOK_URL=


# --- E-mail transacional -----------------------------------------------------
# Provedor ainda não definido: [PROVEDOR_DE_EMAIL]
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
SUPPORT_EMAIL=


# --- Armazenamento de mídia --------------------------------------------------
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=


# --- Geração de mídia (opcional) ---------------------------------------------
# Usado apenas por scripts de geração em desenvolvimento.
# NUNCA referenciado por código que roda em produção.
# Enquanto a trilha gratuita estiver em uso (MEDIA_PLAN.md §3), fica vazio.
KAIROGEN_API_KEY=


# --- Limitação de taxa -------------------------------------------------------
RATE_LIMIT_REDIS_URL=


# --- Observabilidade ---------------------------------------------------------
LOG_LEVEL=
ERROR_TRACKING_DSN=


# --- Administração de desenvolvimento ----------------------------------------
# Usado apenas pelo seed local. Sem valor padrão: o seed exige que seja informado.
# NUNCA definir em produção. Ver DATABASE_SCHEMA.md §8.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
